# Installed by deploy/install-timers.sh. Started by sera-update.timer.
[Unit]
Description=SERA: deploy newly published images, rolling back if the site is unhealthy
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/opt/sera/deploy/auto-update.sh
TimeoutStartSec=20min
