# Installed by deploy/install-timers.sh. Pause with
# `sudo systemctl disable --now sera-update.timer`, or touch /opt/sera/.auto-update-paused.
[Unit]
Description=SERA: look for newly published images every 15 minutes

[Timer]
OnBootSec=10min
OnUnitActiveSec=15min
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
