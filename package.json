{
  "name": "sera-toolkit",
  "version": "1.0.0",
  "private": true,
  "description": "SERA.toolkit — a universal media toolkit for downloading and converting publicly accessible media.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @sera/contracts && npm run build --workspace @sera/engine && npm run build --workspace @sera/api && npm run build --workspace @sera/worker && npm run build --workspace @sera/web",
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev --workspace @sera/api",
    "dev:web": "npm run dev --workspace @sera/web",
    "dev:worker": "npm run dev --workspace @sera/worker",
    "start": "node apps/api/dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --build --pretty && tsc -p tsconfig.tests.json --pretty && tsc -p apps/web/tsconfig.json --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tools:fetch": "node scripts/fetch-tools.mjs",
    "update-providers": "node scripts/update-providers.mjs",
    "verify": "npm run format && npm run lint && npm run typecheck && npm run test && npm run build",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
