# SERA.toolkit configuration.
#
# Copy to `.env` and edit. Every value below is a default that works, except SERA_SECRET,
# which has no safe default and is required in production.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Signs the handles the browser holds. Without a stable value, every handle issued before
# a restart stops validating, and a multi-instance deployment rejects its own tokens.
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SERA_SECRET=

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------

SERA_HOST=0.0.0.0
SERA_PORT=4000

# Port the web front end is published on.
SERA_WEB_PORT=3000

# Where the front end reaches the API. Inside compose this is the service name; in
# development it is the local API.
SERA_API_URL=http://127.0.0.1:4000

# Comma-separated browser origins allowed to call the API directly. Leave empty when the
# front end proxies /api, which is the default and the more private arrangement.
SERA_CORS_ORIGINS=

# Trust X-Forwarded-For. Only enable behind a proxy you control: with it on, any client
# can otherwise claim any address and defeat rate limiting.
SERA_TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Storage and retention
# ---------------------------------------------------------------------------

# Where finished files live before they are deleted.
SERA_DATA_DIR=/data

# How long a finished file is kept. This is the privacy setting: shorter is better, and
# the reaper deletes by age whether or not anyone downloaded the file.
SERA_RETENTION_SECONDS=1800

# How often the reaper sweeps.
SERA_REAP_INTERVAL_SECONDS=120

# How long an analysis and the handles it issued stay valid.
SERA_OPTION_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------

# 4 GiB.
SERA_MAX_FILESIZE_BYTES=4294967296

# 4 hours.
SERA_MAX_DURATION_SECONDS=14400

# Most items one download may combine.
SERA_MAX_ITEMS_PER_JOB=50

# Ceiling on a single job, including conversion.
SERA_JOB_TIMEOUT_SECONDS=1800

# Ceiling on reading a link. Kept short: someone is watching a spinner.
SERA_RESOLVE_TIMEOUT_SECONDS=45

# ---------------------------------------------------------------------------
# Queue and workers
# ---------------------------------------------------------------------------

# `memory` runs the worker inside the API, which is right for a single container.
# `redis` puts a queue between them so workers scale independently.
SERA_QUEUE_DRIVER=memory
SERA_REDIS_URL=redis://127.0.0.1:6379

# Concurrent jobs per worker process. Each one may run FFmpeg, so this is a CPU budget.
SERA_WORKER_CONCURRENCY=2

# Rejects new jobs once this many are waiting, instead of queueing without bound.
SERA_MAX_QUEUE_DEPTH=200

# Ignored for the memory driver, where the API always runs its own worker.
SERA_EMBEDDED_WORKER=true

# Compose only: resource ceiling for a worker container.
SERA_WORKER_CPUS=2
SERA_WORKER_MEMORY=2g

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------

SERA_RATE_LIMIT_RESOLVE_PER_MINUTE=20
SERA_RATE_LIMIT_JOBS_PER_MINUTE=10
SERA_MAX_CONCURRENT_JOBS_PER_CLIENT=3

# ---------------------------------------------------------------------------
# External tools
# ---------------------------------------------------------------------------

# Left empty, SERA prefers a binary in `.tools/` (see `npm run tools:fetch`) and falls
# back to PATH. The container images install both, so these stay empty there.
SERA_YTDLP_PATH=
SERA_FFMPEG_PATH=
SERA_FFPROBE_PATH=

# ---------------------------------------------------------------------------
# Source policy
# ---------------------------------------------------------------------------

# Hostnames the generic extractor may be pointed at, beyond those a dedicated provider
# claims. Empty by default: a link is never handed to the extractor merely because the
# extractor might recognise it. Add hosts you have decided to support.
SERA_EXTRA_ALLOWED_HOSTS=

# Hostnames always refused, checked before anything else.
SERA_BLOCKED_HOSTS=

# Allows connections to private and loopback addresses. Development only — this is the
# SSRF guard, and configuration refuses to start with it enabled in production.
SERA_ALLOW_PRIVATE_ADDRESSES=false

# ---------------------------------------------------------------------------
# Sources that need a credential
# ---------------------------------------------------------------------------

# Reddit refuses anonymous requests from hosted address ranges, which is its documented
# position for servers. These are an application registration, not anyone's account:
# https://www.reddit.com/prefs/apps, type "script". Without them Reddit says plainly that
# it needs credentials.
SERA_REDDIT_CLIENT_ID=
SERA_REDDIT_CLIENT_SECRET=

# Instagram serves photographs to logged-in clients only, from any network. Setting a
# session makes every visitor's Instagram request your account's activity — read the
# warning in deploy/ORACLE.md before setting this on a deployment other people can reach.
SERA_INSTAGRAM_SESSION_ID=

# ---------------------------------------------------------------------------
# Where extraction runs
# ---------------------------------------------------------------------------

# The kind of connection this installation extracts from: datacenter, residential, or
# unknown. Only routing order depends on it, and only for a provider that declares no
# datacentre extraction. The default says nothing, because SERA running on someone's home
# connection must not be demoted by a measurement taken on a cloud host.
SERA_NETWORK_CLASS=unknown

# Lets an extraction node on another network claim work. Empty leaves those endpoints
# unmounted entirely: a deployment with no node should not have an endpoint that accepts
# one. See deploy/EXTRACTION-NODE.md.
SERA_EXTRACTION_NODE_TOKEN=

# How long a node's request for work is held open before it asks again. The hold is the
# heartbeat, so this is also how quickly a vanished node stops being offered work.
SERA_EXTRACTION_CLAIM_HOLD_SECONDS=25

# Player clients to ask YouTube for, comma separated. Empty lets yt-dlp choose, which an
# audit of every client it offers found no reason to override. See the docblock on
# SERA_YOUTUBE_PLAYER_CLIENTS in packages/engine/src/config.ts for the measurements.
SERA_YOUTUBE_PLAYER_CLIENTS=

# Base URL of a yt-dlp PO Token Provider, if you run one. The address only — tokens are
# fetched by the plugin inside yt-dlp and never pass through SERA or its logs.
SERA_YOUTUBE_POT_PROVIDER_URL=

# An outbound proxy for extraction, when this deployment's own address is refused.
# YouTube refuses a datacentre by reputation, not by anything about the request, so no
# choice of client changes it. An extraction node is one answer and needs a machine left
# on; a residential proxy is the other and does not. Credentials in the URL are normal
# and are treated as a secret: redacted from logs and scrubbed from extractor output.
SERA_EXTRACTION_PROXY_URL=

# Providers the proxy is used for, comma separated. Empty means all of them, which is
# rarely what you want: these services bill by the gigabyte and only some providers
# refuse a datacentre in the first place.
SERA_EXTRACTION_PROXY_PROVIDERS=

# ---------------------------------------------------------------------------
# On an extraction node only (see deploy/EXTRACTION-NODE.md)
# ---------------------------------------------------------------------------

# SERA_API_URL=https://your-deployment
# SERA_NODE_ID=home
# SERA_NODE_PROVIDERS=youtube
# SERA_NODE_NETWORK_CLASS=residential

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
